{
  "expo": {
    "name": "Tomato",
    "slug": "tomato",
    "scheme": "tomato",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rkamn.tomato",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tomato to share your live location while you are online for deliveries."
        }
      ]
    ]
  }
}
